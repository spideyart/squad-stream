<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network: RTMP push to YouTube -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Microphone for stream commentary (runtime permission, asked in MainActivity) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground service (Android 14+ mediaProjection + microphone types).
         All three are install-time permissions: declare only, no runtime prompt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Foreground-service notification (Android 13+, runtime permission) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Phase 2 will add SYSTEM_ALERT_WINDOW for the floating HUD bubble. -->

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="SquadStream"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Android 14 rule: the service MUST declare mediaProjection|microphone
             here, and startForeground() must pass the same types before
             MediaProjectionManager.getMediaProjection() is called. -->
        <service
            android:name=".StreamService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />
    </application>
</manifest>
