<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network: RTMP push to YouTube -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Microphone for stream commentary (runtime permission, asked in MainActivity) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground service (Android 14+ mediaProjection + microphone types).
         All three are install-time permissions: declare only, no runtime prompt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Foreground-service notification (Android 13+, runtime permission) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Phase 3: squad voice room — speakerphone / in-call audio mode. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Phase 2: floating HUD bubble over the game. SYSTEM_ALERT_WINDOW is a
         special permission: the user grants it in Settings ("Display over
         other apps"). The HUD service runs as a foreground service of type
         specialUse (it fits no other type). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="SquadStream"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Android 14 rule: the service MUST declare mediaProjection|microphone
             here, and startForeground() must pass the same types before
             MediaProjectionManager.getMediaProjection() is called. -->
        <service
            android:name=".StreamService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <!-- Phase 2: floating HUD. specialUse is the only fitting type; the
             subtype property is required for it on Android 14+. No type is
             passed on older Android (the 2-arg startForeground is used). -->
        <service
            android:name=".HudService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating in-game stream controls" />
        </service>

        <!-- Phase 3: squad voice room. Type microphone: the service captures
             the mic for WebRTC (FOREGROUND_SERVICE_MICROPHONE was already
             declared for the stream service). -->
        <service
            android:name=".VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
